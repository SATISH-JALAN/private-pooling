# Midnight network to connect to: "preprod" or "preview"
VITE_NETWORK_ID=preprod

# Pino logger level: trace | debug | info | warn | error
VITE_LOGGING_LEVEL=info

# Deployed Private Polling contract address on the selected network.
# Replace with the output of: npm run deploy-direct
VITE_CONTRACT_ADDRESS=<YOUR_DEPLOYED_CONTRACT_ADDRESS>
