{
  "name": "@midnight-ntwrk/private-polling-ui",
  "version": "0.1.0",
  "author": "Satish Jalan",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && vite build --mode preprod && node scripts/copy-zk-assets.mjs",
    "build:preview": "tsc && vite build --mode preview && node scripts/copy-zk-assets.mjs",
    "build:start": "npm run build && npm run start",
    "build:start:preview": "npm run build:preview && npm run start",
    "ci": "npm run typecheck && npm run lint && npm run test",
    "dev": "vite --mode preprod",
    "lint": "eslint ./src",
    "start": "http-server --port 4173 -s ./dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "vite preview",
    "dev:preview": "vite --mode preview",
    "test": "vitest run",
    "vercel:output": "node scripts/vercel-output.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@midnight-ntwrk/dapp-connector-api": "4.0.1",
    "@midnight-ntwrk/midnight-js-fetch-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-ntwrk/private-polling-contract": "0.1.0",
    "@mui/icons-material": "^9.1.1",
    "@mui/material": "^9.1.1",
    "fp-ts": "^2.16.11",
    "node-stdlib-browser": "^1.3.1",
    "pino": "^10.3.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "7.17.0",
    "rxjs": "^7.8.2",
    "semver": "^7.8.4"
  },
  "devDependencies": {
    "@swc/core": "^1.16.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint-plugin-react": "^7.37.5",
    "vite-plugin-node-polyfills": "^0.28.0"
  }
}
