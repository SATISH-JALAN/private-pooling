{
  "name": "@midnight-ntwrk/private-polling-ui",
  "version": "0.1.0",
  "author": "IOG",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rm -rf ./dist && tsc && vite build --mode preprod && cp -r ../contract/src/managed/private-polling/keys ./dist/keys && cp -r ../contract/src/managed/private-polling/zkir ./dist/zkir",
    "build:preview": "rm -rf ./dist && tsc && vite build --mode preview && cp -r ../contract/src/managed/private-polling/keys ./dist/keys && cp -r ../contract/src/managed/private-polling/zkir ./dist/zkir",
    "build:start": "npm run build && npm run start",
    "build:start:preview": "npm run build:preview && npm run start",
    "ci": "npm run typecheck && npm run lint",
    "dev": "vite",
    "lint": "eslint ./src",
    "start": "http-server --port 0 ./dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "vite preview",
    "prepack": "yarn build"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@midnight-ntwrk/dapp-connector-api": "4.0.1",
    "@midnight-ntwrk/midnight-js-fetch-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-ntwrk/private-polling-contract": "0.1.0",
    "@mui/icons-material": "^9.1.1",
    "@mui/material": "^9.1.1",
    "fp-ts": "^2.16.11",
    "node-stdlib-browser": "^1.3.1",
    "pino": "^10.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "7.17.0",
    "rxjs": "^7.8.2",
    "semver": "^7.8.4"
  },
  "devDependencies": {
    "@swc/core": "^1.15.41",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint-plugin-react": "^7.37.5",
    "vite-plugin-node-polyfills": "^0.28.0"
  }
}